class_name WitchArtData
extends RefCounted

const DATA := ""

static var _texture: Texture2D

static func get_texture() -> Texture2D:
    if _texture != null:
        return _texture
    var bytes := Marshalls.base64_to_raw(DATA)
    if bytes.is_empty():
        return null
    var image := Image.new()
    if image.load_png_from_buffer(bytes) != OK:
        return null
    _texture = ImageTexture.create_from_image(image)
    return _texture
